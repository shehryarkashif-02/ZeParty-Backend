# ==============================================================================
# ZeParty Backend Environment Configuration Template
# Copy this file to .env and configure with authentic staging/production values.
# NEVER commit the actual .env file or real credentials to source control.
# ==============================================================================

NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=prefer&connect_timeout=30&socket_timeout=60&connection_limit=15&pool_timeout=30"
# Set PRISMA_LOG_QUERIES=true to enable verbose SQL query logging during debugging (default: false)
PRISMA_LOG_QUERIES=false

# Redis Cache, Session Store & Socket.IO Redis Adapter
REDIS_URL="redis://default:password@host:port"

# Public Domain, URLs & CORS Security (Staging / Production examples)
# In development: http://localhost:5173
# In staging: https://admin-staging.example.com
CORS_ORIGIN=https://admin-staging.example.com
SOCKET_CORS_ORIGIN=https://admin-staging.example.com
PUBLIC_API_URL=https://api-staging.example.com

# Authentication & JWT Configuration
JWT_SECRET=your-minimum-32-character-secret-key-for-jwt-signing
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Initial Super Admin / Owner Bootstrap (Optional overrides for database seed)
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@zeparty.app
SUPER_ADMIN_PASSWORD=your_secure_super_admin_password
OWNER_USERNAME=owner
OWNER_EMAIL=owner@zeparty.app
OWNER_PASSWORD=your_secure_owner_password

# Encryption Keys (AES-256 for payment tokens and sensitive OTPs)
PAYMENT_ENCRYPTION_KEY=your-32-byte-encryption-key-for-payments!
OTP_ENCRYPTION_KEY=your-32-byte-encryption-key-for-otps!

# Phone Authentication / OTP Provider ('mock', 'twilio', 'aws_sns')
OTP_PROVIDER=mock
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=5

# Twilio SMS Credentials (Required only if OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_registered_phone_number

# AWS Credentials (Required for AWS SNS OTP or AWS S3 Storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Media Storage Provider ('local', 's3', 'r2')
STORAGE_PROVIDER=local
S3_BUCKET_NAME=zeparty-media
CDN_BASE_URL=http://localhost:5000/uploads

# Agora Real-Time Audio / Video RTC & PK Battle Engine
AGORA_APP_ID=your_32_character_agora_app_id
AGORA_APP_CERTIFICATE=your_32_character_agora_app_certificate
AGORA_TOKEN_EXPIRY_SECONDS=3600
AGORA_MOCK_MODE=false

# Firebase Admin SDK / Push Notifications (Optional - for OS push alerts)
FIREBASE_PROJECT_ID=zeparty-79828
FIREBASE_SERVICE_ACCOUNT=path/to/firebase-service-account.json
FCM_MOCK_MODE=false

# Payment Webhook Secrets (Optional - for live gateway callbacks)
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_key
